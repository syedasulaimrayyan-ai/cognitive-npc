# Supabase project — PUBLISHABLE values only (safe in the browser bundle;
# Row Level Security enforces access server-side).
# Copy this file to .env and fill in from: Supabase Dashboard → Project Settings → API
#
# NEVER put these here (they belong in Supabase Edge Function secrets):
#   GEMINI_API_KEY          -> supabase secrets set GEMINI_API_KEY=...
#   service_role / SUPABASE_SERVICE_ROLE_KEY -> never used by this app at all

VITE_SUPABASE_URL=https://YOUR-PROJECT-R.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
